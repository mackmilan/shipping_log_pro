{
  "name": "shipping-log-pro",
  "version": "1.0.0",
  "description": "Sistema de Controle de Janela de Tempos de Descarga de Caminhões",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "./ci --setup-only",
    "ci": "./ci",
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm run test --prefix backend",
    "test:backend:cov": "npm run test:cov --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:frontend:cov": "npm run test:coverage --prefix frontend",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "node ./node_modules/@playwright/test/cli.js test --ui",
    "test:e2e:report": "node ./node_modules/@playwright/test/cli.js show-report playwright-report",
    "test": "npm run test:backend && npm run test:frontend && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.1"
  }
}
